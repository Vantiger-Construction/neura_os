# Match Dart's const bool.fromEnvironment('NEURA_DEMO') exactly. Reject duplicate
# or malformed values so the Dart entrypoint and native host cannot disagree.
function(neura_demo_from_environment output)
  set(enabled FALSE)
  set(definition_count 0)
  set(environment_count 0)
  foreach(item IN LISTS ARGN)
    if(item MATCHES "^DART_DEFINES=")
      math(EXPR environment_count "${environment_count}+1")
      if(environment_count GREATER 1)
        message(FATAL_ERROR "DART_DEFINES must have a single source")
      endif()
      string(REGEX REPLACE "^DART_DEFINES=" "" definitions "${item}")
      string(REPLACE "," ";" definitions "${definitions}")
      foreach(definition IN LISTS definitions)
        if(definition MATCHES "^TkVVUkFfREVNTz")
          math(EXPR definition_count "${definition_count}+1")
          if(definition_count GREATER 1)
            message(FATAL_ERROR "NEURA_DEMO must be specified exactly once")
          endif()
          if(definition STREQUAL "TkVVUkFfREVNTz10cnVl")
            set(enabled TRUE)
          elseif(NOT definition STREQUAL "TkVVUkFfREVNTz1mYWxzZQ==")
            message(FATAL_ERROR "NEURA_DEMO must be true or false")
          endif()
        endif()
      endforeach()
    endif()
  endforeach()
  set(${output} ${enabled} PARENT_SCOPE)
endfunction()

function(neura_read_demo_configuration config_file)
  set(FLUTTER_TOOL_ENVIRONMENT "")
  include("${config_file}")
  neura_demo_from_environment(enabled ${FLUTTER_TOOL_ENVIRONMENT})
  set(NEURA_ISOLATED_DEMO ${enabled} PARENT_SCOPE)
endfunction()
