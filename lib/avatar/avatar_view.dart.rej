+
+  Widget _withBody(Widget rendered) {
+    if (!widget.animateBody) return rendered;
+    return SizedBox(
+      width: size,
+      height: size,
+      child: NeuraAnimatedBody(
+        showAura: widget.showAura,
+        child: rendered,
+      ),
+    );
+  }
+
+  Widget _render(
+    BuildContext context,
+    AvatarFormat format,
+    String path,
+    Widget fallback,
+  ) {
+    switch (format) {
+      case AvatarFormat.rive:
+        final adjusted = (path == spec.assetPath)
+            ? spec
+            : AvatarSpec(
+                id: spec.id,
+                name: spec.name,
+                format: AvatarFormat.rive,
+                assetPath: path,
+                fallbackAssetPath: spec.fallbackAssetPath,
+                rive: spec.rive,
+                lottie: spec.lottie,
+                sprite: spec.sprite,
+              );
+        return RiveAvatarView(
+          spec: adjusted,
+          controller: controller,
+          size: size,
+          fit: fit,
+          fallback: fallback,
+        );
+      case AvatarFormat.lottie:
+        // Render using spec.lottie variants, but ensure spec.assetPath points to the resolved path.
+        final adjusted = AvatarSpec(
+          id: spec.id,
+          name: spec.name,
+          format: AvatarFormat.lottie,
+          assetPath: path,
+          fallbackAssetPath: spec.fallbackAssetPath,
+          lottie: spec.lottie,
+        );
+        return AnimatedBuilder(
+          animation: controller,
+          builder: (_, __) => LottieAvatarView(
+            spec: adjusted,
+            controller: controller,
+            size: size,
+            fit: fit,
+            fallback: fallback,
+          ),
+        );
+      case AvatarFormat.sprite:
+        return SpriteAvatarView(
+          spec: spec,
+          size: size,
+          fit: fit,
+          fallback: fallback,
+        );
+      case AvatarFormat.image:
+        return SizedBox(
+          width: size,
+          height: size,
+          child: Image.asset(
+            path,
+            fit: fit,
+            // Height-only decode keeps the art's aspect ratio (setting both
+            // cache dimensions squashed tall art into a square).
+            cacheHeight:
+                (size * MediaQuery.devicePixelRatioOf(context)).round(),
+            errorBuilder: (_, __, ___) => fallback,
+          ),
+        );
+    }
+  }
