name: neuro_companion
description: A lightweight mental wellness assistant.
version: 1.0.0+1

environment:
  sdk: ">=3.0.0 <4.0.0"

dependencies:
  flutter:
    sdk: flutter
  shared_preferences: ^2.2.0
  path_provider: ^2.1.2
  share_plus: ^7.0.0
  speech_to_text: ^6.3.0
  cryptography: ^2.7.0
  file_picker: ^5.5.0
  archive: ^4.0.7
  pdf: ^3.11.3

  # Optional / future modules
  flutter_riverpod: ^2.4.0
  firebase_crashlytics: ^3.3.3
  azure_storage_blobs: ^0.11.0
  azure_identity: ^0.1.0

dev_dependencies:
  flutter_test:
    sdk: flutter

flutter:
  uses-material-design: true
